@startuml Class Diagram - Vertical

!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

package "colleges_data" {
    class COLLEGES
}

package "chatbot.views" {
    class Views {
        + select_college(request)
        + enter_chat(request)
        + chat_page(request)
        + chatbot(request)
        + generate_response(prompt)
        + translate_to_english(text)
        + translate_back(text, lang)
        + is_general_conversation(msg)
        + refine_user_question(q)
    }
}

package "chatbot.rag" class RAGSystem {
    + ensure_index(college_id)
    + retrieve_context(college_id, question)
    - build_index_background(college_id)
    - get_embed_model()
    - smart_chunk(text)
}

package "chatbot.crawler" class WebCrawler {
    + crawl_college_sources(info)
    - async_crawl_all(info)
    - crawl_official(page, url)
    - extract_pdf_text(url)
}

class BytezAI
class GoogleTranslator
class LangDetect

Views -down-> COLLEGES
Views -down-> RAGSystem
Views -down-> WebCrawler
Views -down-> BytezAI
Views -down-> GoogleTranslator
Views -down-> LangDetect
RAGSystem -down-> BytezAI

@enduml

@startuml Sequence Diagram - Vertical

!theme plain
skinparam backgroundColor #ffffff
skinparam linetype ortho

actor User
participant Browser
participant Views
participant Intent
participant QueryRef
participant Vector
participant Crawler
participant AI
participant Translate

Browser->Views: POST /api/chat/
Views->Translate: translate_to_english()
Translate-->Views: english_question
Views->Intent: is_general_conversation()

alt Chat
    Intent-->Views: true
    Views->AI: openai_chat_reply()
    AI-->Views: chat_reply
    Views->Translate: translate_back()
    Translate-->Views: response
else Info Query
    Intent-->Views: false
    Views->QueryRef: refine_question()
    QueryRef-->Views: optimized
    Views->Vector: retrieve_context()
    Vector-->Views: context
    Views->Crawler: fetch_from_sources()
    Crawler-->Views: website_data
    Views->AI: generate_response()
    AI-->Views: answer
    Views->Translate: translate_back()
    Translate-->Views: translated
end

Views-->Browser: JSON response
Browser-->User: Display

@enduml

@startuml Activity - Chat Flow - Vertical

!theme plain
skinparam activityBackgroundColor #e8f5e9
skinparam activityBorderColor #2e7d32
skinparam linetype ortho
skinparam nodesep 30

start
:Send message;

if (Empty?) then (yes)
    :Error;
    stop
endif

if (No college?) then (yes)
    :Error;
    stop
endif

if (No index?) then (yes)
    :Build KB;
    :Wait message;
    stop
endif

:Detect language;
:Translate to English;

:Classify intent;

if (Intent = CHAT?) then (yes)
    :Generate reply;
    :Translate reply;
    :Return;
    stop
endif

:Expand synonyms;
:Optimize query;

:Retrieve vector;
:Fetch web data;
:Combine contexts;

if (No context?) then (yes)
    :Not available;
    stop
endif

:Generate AI response;
:Translate response;

:Return response;

stop

@enduml

