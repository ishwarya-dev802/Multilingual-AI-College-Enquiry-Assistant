@startuml System Architecture - Vertical

!theme plain
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70

package "Client Layer" {
    component [Web Browser\n(HTML/CSS/JS)] as Browser
}

package "Django Web Server" {
    component [Django Views\n(views.py)] as Views
    component [URL Router\n(urls.py)] as Router
    component [Session\nManagement] as Session
    database [SQLite] as DB
}

package "Chatbot Application" {
    component [Chat Handler] as ChatHandler
    component [Intent\nClassifier] as IntentClassifier
    component [Query\nRefiner] as QueryRefiner
    component [Translation\nService] as Translator
    component [Response\nGenerator] as ResponseGenerator
}

package "RAG System" {
    component [Vector\nRetrieval] as VectorRetrieval
    component [FAISS\nIndex] as FAISS
    component [BM25\nSearch] as BM25
    component [Hybrid\nRanker] as Ranker
    database [Vector Store] as VectorStore
}

package "Data Collection" {
    component [Web Crawler] as Crawler
    component [PDF\nExtractor] as PDFExtractor
    component [HTML\nCleaner] as HTMLCleaner
}

package "External Services" {
    component [Bytez AI] as BytezAI
    component [Google\nTranslator] as TranslatorAPI
    component [LangDetect] as LangDetect
    component [College\nWebsites] as CollegeWeb
    component [Wikipedia] as Wiki
    component [Aggregators] as Aggregators
}

Browser -down-> Router
Router -down-> Views
Views -down-> Session
Session -down-> DB

Views -down-> ChatHandler
ChatHandler -down-> IntentClassifier
ChatHandler -down-> QueryRefiner
ChatHandler -down-> Translator
ChatHandler -down-> ResponseGenerator

QueryRefiner -down-> VectorRetrieval
VectorRetrieval -down-> FAISS
VectorRetrieval -down-> BM25
VectorRetrieval -down-> Ranker
FAISS -down-> VectorStore
BM25 -down-> VectorStore

ChatHandler -down-> Crawler
Crawler -down-> CollegeWeb
Crawler -down-> Wiki
Crawler -down-> Aggregators
Crawler -down-> PDFExtractor
PDFExtractor -down-> CollegeWeb

ResponseGenerator -down-> BytezAI
Translator -down-> TranslatorAPI
Translator -down-> LangDetect

@enduml

@startuml Data Flow - Vertical

!theme plain
skinparam activityBackgroundColor #f0f0f0
skinparam arrowColor #333333
skinparam linetype ortho
skinparam nodesep 40

start
:User selects college;
:Session stores college_id;

:User enters question;

:Question sent via API;

:Translate to English;

:Classify intent;

if (Casual Chat?) then (yes)
    :Generate chat reply;
    :Translate to user language;
    :Return response;
else (no)
    :Clean and refine query;
    :Expand with synonyms;
    :Retrieve from vector store;
    :Fetch website data;
    :Combine contexts;
    :Generate AI response;
    :Translate to user language;
    :Return response;
endif

:Display in UI;

stop

@enduml

